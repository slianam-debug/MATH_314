<exercise>
        <statement>
      <p>
   Determine, with explanation, whether the graph below is planar.  </p>
<figure xml:id="fig">
  <caption>Problem 1 figure</caption>
  <image width="50%" xml:id="mygraph">
    <shortdescription>a graph</shortdescription>
<latex-image >
\begin{tikzpicture}[
    vertex/.style={circle, fill=black, inner sep=2.5pt},
    line width=0.9pt]

% Vertices
\node[vertex, label=above left:$a$] (a) at (-2,2) {};
\node[vertex, label=above:$b$] (b) at (0,2.6) {};
\node[vertex, label=above right:$c$] (c) at (2,2) {};
\node[vertex, label=right:$d$] (d) at (2.6,0) {};
\node[vertex, label=below right:$e$] (e) at (2,-2) {};
\node[vertex, label=below:$f$] (f) at (0,-2.6) {};
\node[vertex, label=below left:$g$] (g) at (-2,-2) {};
\node[vertex, label=left:$h$] (h) at (-2.6,0) {};

% Outer cycle
\draw (a)--(b)--(c)--(d)--(e)--(f)--(g)--(h)--(a);

% Additional edges
\draw (a)--(d);
\draw (b)--(g);
\draw (c)--(f);
\draw (e)--(h);
\end{tikzpicture}
</latex-image>
</image>
</figure>
</statement>
</exercise>


